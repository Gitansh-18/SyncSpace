# PostgreSQL connection string used by the running app.
# This app runs as a single Next.js instance (not a serverless fan-out), so we
# use the DIRECT connection (port 5432). Measured from this network the
# transaction pooler (port 6543) adds ~1.2 seconds of latency per query, which
# stacks badly inside interactive transactions and caused Prisma's
# P2028 "Unable to start a transaction in the given time" acquisition timeout.
# connection_limit keeps the pool small and bounded (well under Supabase's
# max_connections). Do NOT add pgbouncer=true here - it is for the pooler URL.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.puqashffmiuostgplleo.supabase.co:5432/postgres?connection_limit=5"

# Direct database URL for Prisma migrations in hosted Postgres providers.
# For Supabase, use the direct connection or session pooler URL on port 5432 here.
# Do not add pgbouncer=true to DIRECT_URL.
DIRECT_URL="postgresql://postgres:@db.puqashffmiuostgplleo.supabase.co:5432/postgres"

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-secret"

# Production deployments should set this to the public app URL.
# Example: https://your-domain.com
AUTH_URL="http://localhost:3000"

# Optional AI features. Leave empty to use the local fallback responses.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Invitation emails are sent through the existing send-invitation Supabase Edge
# Function. SUPABASE_SECRET_KEY must be a new-format secret API key
# (sb_secret_...) from Supabase Dashboard -> Project Settings -> API Keys;
# the @supabase/server library rejects legacy service_role JWT keys.
SUPABASE_URL="https://puqashffmiuostgplleo.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."

# Optional verified Resend sender; leave empty to use onboarding@resend.dev.
RESEND_FROM=""
